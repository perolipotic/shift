{
  "name": "shift",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "pnpm -r build",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json && tsc -p e2e/tsconfig.json && tsc -p smoke/tsconfig.json && pnpm -r typecheck",
    "test": "pnpm -r test && vitest run",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:smoke": "playwright test -c playwright.smoke.config.ts",
    "db:reset": "supabase db reset",
    "db:diff": "supabase db diff",
    "db:provision": "supabase db query --local -f supabase/operator/provision-organization.sql"
  },
  "devDependencies": {
    "@babel/core": "8.0.1",
    "@babel/eslint-parser": "8.0.1",
    "@babel/plugin-syntax-jsx": "8.0.1",
    "@babel/preset-typescript": "8.0.1",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/culori": "4.0.1",
    "@types/node": "24.13.3",
    "@types/pg": "8.23.1",
    "culori": "4.0.2",
    "eslint": "10.9.1",
    "globals": "17.12.0",
    "pg": "8.23.0",
    "supabase": "2.116.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11",
    "wrangler": "4.137.0"
  }
}
