# Environment for the admin-auth Edge Function. Copy, do not edit in place:
#
#   cp supabase/functions/.env.example supabase/functions/.env
#
# `supabase functions serve` reads supabase/functions/.env by default, and
# `supabase secrets set --env-file <file>` pushes one of these per environment.
# Every real copy is gitignored — only this template is committed.
#
# NEVER commit a real key, and never paste one on a command line: an argument
# lands in shell history, an env file does not. See DEPLOY.md §3.
#
# SUPABASE_URL is NOT listed here: the Edge Runtime injects it, and the
# `SUPABASE_` prefix is reserved so it cannot be set as a secret anyway. Locally
# `supabase functions serve` injects it too.

# The secret key (`sb_secret_...`) for this environment, and the only place in
# the system it exists (AD-17). Replace the placeholder; do not lengthen it.
SHIFT_SECRET_KEY=sb_secret_...

# The publishable key (`sb_publishable_...`) for the same environment. The
# function needs it to build the caller-scoped client that carries the caller's
# JWT, so RLS and attribution still apply to every domain-table write.
SHIFT_PUBLISHABLE_KEY=sb_publishable_...

# Comma-separated exact origins allowed to call this function. An origin not on
# this list receives no Access-Control-Allow-* header and the browser refuses
# the response. Set it to the Pages hostname(s) for this environment.
SHIFT_ALLOWED_ORIGINS=http://127.0.0.1:5173
