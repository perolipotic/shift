# Operator inputs for the production stack (Coolify project shift-production),
# set in the Coolify resource's environment beside the compose file in this
# directory.
#
# PLACEHOLDERS ONLY. This repository is public: replace each `<…>` in Coolify,
# never here. No secret goes in this file. Every stack secret is generated by
# Coolify (`SERVICE_PASSWORD_*`, `SERVICE_SUPABASEANON_KEY`,
# `SERVICE_SUPABASESERVICE_KEY`) and is not listed; the ones below that no
# generator can make are set in Coolify only, and the stack refuses to start
# without them. No value is ever shared with staging. See DEPLOY.md
# "Self-hosted stack (story 20.1)".

# ------------------------------------------------------------------ the origin
# The app's origin for this environment: GoTrue's site URL and redirect allow
# list, the functions' allowed origin, and the base of every link an email
# carries. The API's own domain is set on the Kong service in Coolify.
SHIFT_APP_URL=https://app.<domain>

# ------------------------------------------------------------ loopback ports
# Postgres and Studio publish on 127.0.0.1 only, reached over the tailnet with
# `tailscale serve`. Pick two free host ports, other than staging's; never
# commit them.
POSTGRES_LOOPBACK_PORT=<loopback-port>
STUDIO_LOOPBACK_PORT=<loopback-port>

# ------------------------------------------------------- functions (20.2)
# The `shift-functions` image this stack's edge-runtime runs: built by CI from
# deploy/functions/Dockerfile. A reference, not a secret, and set once: the
# environment's channel tag, which the deploy pipeline (20.6) moves to each
# release's probed digest. To roll back, set the previous release's DIGEST
# from its run summary here (`…/shift-functions@sha256:<hex>`; commit tags can
# be overwritten by a re-run) and restart (DEPLOY.md §8.7).
SHIFT_FUNCTIONS_IMAGE=ghcr.io/<owner>/shift-functions:production

# ------------------------------------------------------------- notify (10.1)
# The sender, on the domain verified in Resend. The quotes are for this file's
# KEY=value form: in Coolify's single-variable field, enter the value without them.
NOTIFY_EMAIL_FROM="Shift <obavijesti@<domain>>"
# Operator-set secret: the Resend API key (`re_…`) for this environment.
RESEND_API_KEY=
# Operator-set: the VAPID pair for this environment (DEPLOY.md §3a). The public
# half is also the SPA's build-time public key for this environment; the
# private half is a secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:obavijesti@<domain>

# ------------------------------------------------------- the signup door (19.1)
# AD-21's first switch. Production keeps it SHUT: both `true`, the compose's own
# defaults. Opening production is the founder's decision at D-S5, after the
# security review (SECURITY-REVIEW-EPIC-19.md, section H), and
# `test/supabase-scaffold.test.ts` fails if either value here opens the door.
SHIFT_DISABLE_SIGNUP=true
SHIFT_MAILER_AUTOCONFIRM=true
# Operator-set secret: GoTrue's OWN Resend key, sending-only and restricted to
# the sending domain, never notify's RESEND_API_KEY (AD-17 as amended). Set in
# Coolify on the auth resource alone; it may stay empty while the door is shut.
GOTRUE_SMTP_PASS=
# The Auth email sender, on the domain verified in Resend.
SHIFT_AUTH_EMAIL_FROM=obavijesti@<domain>
# GoTrue's Auth email budget for the whole stack, per hour (A9): Resend's daily
# allowance is shared with notify.
SHIFT_AUTH_EMAIL_PER_HOUR=10

# ------------------------------------------- the client's address (19.1, AD-21)
# The network of Coolify's Traefik on this host, as one or more CIDRs: the only
# peers Kong believes about `X-Forwarded-For`. Read it on the host (DEPLOY.md
# §9.9); never commit it. Kong refuses an empty value and any /0.
SHIFT_PROXY_CIDR=<proxy-cidr>

# ------------------------------------------- Kong's per-IP limits (19.1, AD-21)
# Staging's values until the D-S5 checklist sets production's (section H, 2). Kong 2.8 has no
# 5-minute window, so each is a count per minute, hour or day. The mail routes
# (signup, recover, resend) share one count.
SHIFT_LIMIT_MAIL_HOUR=5
SHIFT_LIMIT_MAIL_DAY=20
SHIFT_LIMIT_TOKEN_MINUTE=60
SHIFT_LIMIT_TOKEN_HOUR=1440
SHIFT_LIMIT_VERIFY_MINUTE=15
SHIFT_LIMIT_VERIFY_HOUR=360
SHIFT_LIMIT_CREATE_ORGANIZATION_HOUR=10

# ------------------------------------------------------------------- limits
# Production's limits: about 2.9 GiB for the whole stack. Each is at least
# staging's, and the compose defaults are staging's, so a variable left out
# here fails low rather than high.
POSTGRES_SHARED_BUFFERS=256MB
DB_MEM_LIMIT=1g
DB_CPUS=1.0
KONG_MEM_LIMIT=256m
KONG_CPUS=0.5
AUTH_MEM_LIMIT=128m
AUTH_CPUS=0.25
REST_MEM_LIMIT=128m
REST_CPUS=0.25
STORAGE_MEM_LIMIT=256m
STORAGE_CPUS=0.25
META_MEM_LIMIT=128m
META_CPUS=0.25
STUDIO_MEM_LIMIT=512m
STUDIO_CPUS=0.5
FUNCTIONS_MEM_LIMIT=512m
FUNCTIONS_CPUS=0.5
