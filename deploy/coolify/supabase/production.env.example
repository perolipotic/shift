# Operator inputs for the production stack (Coolify project shift-production),
# set in the Coolify resource's environment beside the compose file in this
# directory.
#
# PLACEHOLDERS ONLY. This repository is public: replace each `<…>` in Coolify,
# never here. No secret goes in this file. Every stack secret is generated by
# Coolify (`SERVICE_PASSWORD_*`, `SERVICE_SUPABASEANON_KEY`,
# `SERVICE_SUPABASESERVICE_KEY`) and is not listed; the ones below that no
# generator can make are set in Coolify only, and the stack refuses to start
# without them. No value is ever shared with staging. See DEPLOY.md
# "Self-hosted stack (story 20.1)".

# ------------------------------------------------------------------ the origin
# The app's origin for this environment: GoTrue's site URL and redirect allow
# list, the functions' allowed origin, and the base of every link an email
# carries. The API's own domain is set on the Kong service in Coolify.
SHIFT_APP_URL=https://app.<domain>

# ------------------------------------------------------------ loopback ports
# Postgres and Studio publish on 127.0.0.1 only, reached over the tailnet with
# `tailscale serve`. Pick two free host ports, other than staging's; never
# commit them.
POSTGRES_LOOPBACK_PORT=<loopback-port>
STUDIO_LOOPBACK_PORT=<loopback-port>

# ------------------------------------------------------------- notify (10.1)
# The sender, on the domain verified in Resend. The quotes are for this file's
# KEY=value form: in Coolify's single-variable field, enter the value without them.
NOTIFY_EMAIL_FROM="Shift <obavijesti@<domain>>"
# Operator-set secret: the Resend API key (`re_…`) for this environment.
RESEND_API_KEY=
# Operator-set: the VAPID pair for this environment (DEPLOY.md §3a). The public
# half is also the SPA's build-time public key for this environment; the
# private half is a secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:obavijesti@<domain>

# ------------------------------------------------------------------- limits
# Production's limits: about 2.9 GiB for the whole stack. Each is at least
# staging's, and the compose defaults are staging's, so a variable left out
# here fails low rather than high.
POSTGRES_SHARED_BUFFERS=256MB
DB_MEM_LIMIT=1g
DB_CPUS=1.0
KONG_MEM_LIMIT=256m
KONG_CPUS=0.5
AUTH_MEM_LIMIT=128m
AUTH_CPUS=0.25
REST_MEM_LIMIT=128m
REST_CPUS=0.25
STORAGE_MEM_LIMIT=256m
STORAGE_CPUS=0.25
META_MEM_LIMIT=128m
META_CPUS=0.25
STUDIO_MEM_LIMIT=512m
STUDIO_CPUS=0.5
FUNCTIONS_MEM_LIMIT=512m
FUNCTIONS_CPUS=0.5
