# Story 20.4: the values `shift-host.sh` closes the host with.
#
# Copy it outside the checkout (DEPLOY.md §9.8, step 2) and fill it from THAT
# host's own inspection (step 1); `apply` passes it with `--env <file>`, and
# `confirm` keeps it as /etc/shift-host/host.env. Never commit a filled copy:
# this repository is public, and these are the host's interface names and
# ports.
#
# Every value has a default in the script; a line here overrides it.

# The interface that faces the internet and carries the default route. Only
# 80/tcp, 443/tcp and 443/udp are admitted on it (plus established traffic,
# ICMP, DHCP and Tailscale's UDP port to the host itself).
PUBLIC_IF=eth0

# The Tailscale interface. SSH is admitted from it, and nothing that arrives on
# it is filtered by these rules (the tailnet's ACL decides who reaches what).
TAILSCALE_IF=tailscale0

# Tailscale's WireGuard port, admitted on the public interface so peers can
# connect directly instead of through a relay.
TAILSCALE_UDP_PORT=41641

# The port sshd listens on. With socket activation (Ubuntu 24.04 on) it is
# ssh.socket's ListenStream, generated from sshd_config's Port.
SSH_PORT=22

# The unit `apply sshd` reloads.
SSH_SERVICE=ssh.service

# Coolify's own Docker network. Coolify reaches its host over SSH from it, so
# SSH is admitted from this network's bridge and subnets. The bridge and the
# subnets are read from `docker network inspect` when the rules are applied;
# to pin them instead, set COOLIFY_BRIDGE and COOLIFY_SUBNET4 (and
# COOLIFY_SUBNET6 if it has one) together.
COOLIFY_NETWORK=coolify

# Coolify's database container and login (its auto-update setting lives there).
COOLIFY_DB_CONTAINER=coolify-db
COOLIFY_DB_USER=coolify
COOLIFY_DB_NAME=coolify

# Coolify's own environment file; AUTOUPDATE=false is pinned there.
COOLIFY_SOURCE_ENV=/data/coolify/source/.env

# The swapfile (H-15). vm.swappiness is fixed at 10 (sysctl/99-shift-swap.conf).
SWAPFILE=/swapfile
SWAP_SIZE_MIB=4096

# Seconds before an unconfirmed `apply` of the firewall and sshd is reverted.
REVERT_AFTER=300
