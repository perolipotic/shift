# Domain purity (spec 1.1a) is a module-resolution property: `packages/domain`
# declares no dependencies, so `import 'react'` there cannot resolve and the
# build fails. Hoisting would let that import resolve and destroy the guard.
# NEVER set node-linker=hoisted or shamefully-hoist=true in this file.
node-linker=isolated
shamefully-hoist=false

# Every version in this workspace is pinned exactly.
save-exact=true
