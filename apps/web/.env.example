# Build-time environment for apps/web. Copy to .env.local for local work and
# set the same variables per environment in the deploy (DEPLOY.md).
#
# AD-17: this bundle ships the PUBLISHABLE key only. A value starting with
# sb_secret_ here is a security defect — the secret key belongs solely to the
# admin-auth Edge Function's per-environment secrets.

VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_replace_me

# Story 10.4 (AD-17, amended): the VAPID PUBLIC key a device subscribes to push
# under, unpadded base64url (87 characters). Public by design: the matching
# VAPID private key lives only in the notify function's environment. Generate
# the pair once per environment with `pnpm dlx web-push@3.6.7 generate-vapid-keys`.
# Left empty, push cannot be turned on (the screen shows a failure).
VITE_VAPID_PUBLIC_KEY=
